# Observability backend endpoints
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# HTTP client settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Aggregator behavior
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOG_LINES=500
MAX_TRACES=50

# ── Multi-environment support ────────────────────────────────────────────────
# Current environment can be: local | staging | production
# UI: sidebar → Setting → Environment
ENVIRONMENT_NAME=local

# Local environment URLs used when ENVIRONMENT_NAME=local.
LOCAL_PROMETHEUS_URL=http://localhost:9090
LOCAL_LOKI_URL=http://localhost:3100
LOCAL_JAEGER_URL=http://localhost:16686

# Add your staging backend URLs here.
STAGING_PROMETHEUS_URL=
STAGING_LOKI_URL=
STAGING_JAEGER_URL=

# Add your production backend URLs here.
PRODUCTION_PROMETHEUS_URL=
PRODUCTION_LOKI_URL=
PRODUCTION_JAEGER_URL=

# RCA — Anthropic API
# (You can also leave this blank and enter the key in the UI's Config LLM panel.)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
RCA_ENABLED=true
RCA_MODE=simple

# RCA — Hermes agent API server
# Set RCA_MODE=hermes and point this at a running Hermes OpenAI-compatible API server.
# The aggregator calls POST /chat/completions on this base URL.
HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=90
HERMES_TOOLS_ENABLED=true
HERMES_MAX_TOOL_ROUNDS=4
HERMES_MAX_TOOL_CALLS=8
HERMES_TOOL_LOOKBACK_MAX_MINUTES=120

# RCA — GitHub integration (optional — RCA works without these).
# Per-service repos are configured in infra/service-registry.yml; GITHUB_REPO is the fallback.
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=n-phan/Kubernetes-Observability-Signal-Aggregator

# Query/incident history (SQLite) — path is relative to the aggregator's working dir.
HISTORY_DB_PATH=data/history.db

# ── Proactive Notifications ──────────────────────────────────────────────────
# Email-only watchdog alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dishajadav12402@gmail.com
SMTP_USE_STARTTLS=true
ALERT_EMAIL=dishajadav12402@gmail.com

# API server
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

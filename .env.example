# Observability backend endpoints
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# HTTP client settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Aggregator behavior
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOG_LINES=500
MAX_TRACES=50

# RCA — Anthropic API
# (You can also leave this blank and enter the key in the UI's Config LLM panel.)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
RCA_ENABLED=true

# RCA — GitHub integration (optional — RCA works without these).
# Per-service repos are configured in infra/service-registry.yml; GITHUB_REPO is the fallback.
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=n-phan/Kubernetes-Observability-Signal-Aggregator

# Query/incident history (SQLite) — path is relative to the aggregator's working dir.
HISTORY_DB_PATH=data/history.db

# API server
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

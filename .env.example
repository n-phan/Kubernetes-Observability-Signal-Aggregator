# Observability backend endpoints
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# HTTP client settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Aggregator behavior
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOG_LINES=500
MAX_TRACES=50

# RCA — Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
RCA_ENABLED=true
RCA_MODE=simple

# RCA — Hermes agent API server
# Set RCA_MODE=hermes and point this at a running Hermes OpenAI-compatible API server.
# The aggregator calls POST /chat/completions on this base URL.
HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=90
HERMES_TOOLS_ENABLED=true
HERMES_MAX_TOOL_ROUNDS=4
HERMES_MAX_TOOL_CALLS=8
HERMES_TOOL_LOOKBACK_MAX_MINUTES=120

# RCA — GitHub integration (optional — RCA works without these)
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=n-phan/k8s-obs-aggregator-final

# API server
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

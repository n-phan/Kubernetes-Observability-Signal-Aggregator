# Observability backend endpoints
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# HTTP client settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Aggregator behavior
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOG_LINES=500
MAX_TRACES=50

# RCA — Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
RCA_ENABLED=true

# RCA — GitHub integration (optional — RCA works without these)
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=n-phan/k8s-obs-aggregator-final

# API server
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
